<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ExpenseActivity">


    <ImageView
        android:id="@+id/home_btn_cate"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_home" />

    <TextView
        android:id="@+id/cate_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginTop="52dp"
        android:fontFamily="monospace"
        android:text="ADD NEW EXPENSE/INCOME"
        android:textAlignment="center"
        android:textColor="#121010"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/cate_limit"
        android:layout_width="353dp"
        android:layout_height="43dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/purple_button_border"
        android:ems="10"
        android:fontFamily="monospace"
        android:hint=" R100.00"
        android:inputType="number"
        android:paddingStart="10sp"
        android:textAlignment="textStart"
        android:textColor="@color/DarkViolet"
        android:textColorHint="@color/DarkViolet"
        android:textSize="14sp"
        app:iconTint="@color/DarkViolet"
        app:layout_constraintStart_toStartOf="@+id/limit_lbl"
        app:layout_constraintTop_toBottomOf="@+id/limit_lbl2" />

    <EditText
        android:id="@+id/cate_limit2"
        android:layout_width="353dp"
        android:layout_height="43dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/purple_button_border"
        android:ems="10"
        android:fontFamily="monospace"
        android:hint=" COMPULSORY"
        android:inputType="number"
        android:paddingStart="10sp"
        android:textAlignment="textStart"
        android:textColor="@color/DarkViolet"
        android:textColorHint="@color/DarkViolet"
        android:textSize="14sp"
        app:iconTint="@color/DarkViolet"
        app:layout_constraintStart_toStartOf="@+id/limit_lbl"
        app:layout_constraintTop_toBottomOf="@+id/limit_lbl" />

    <EditText
        android:id="@+id/cate_name"
        android:layout_width="353dp"
        android:layout_height="43dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/purple_button_border"
        android:ems="10"
        android:fontFamily="monospace"
        android:hint=" DD - MM - YYYY"
        android:inputType="text"
        android:paddingStart="10sp"
        android:textAlignment="textStart"
        android:textColor="@color/DarkViolet"
        android:textColorHint="@color/DarkViolet"
        android:textSize="14sp"
        app:iconTint="@color/DarkViolet"
        app:layout_constraintStart_toStartOf="@+id/category_lbl"
        app:layout_constraintTop_toBottomOf="@+id/category_lbl" />

    <TextView
        android:id="@+id/category_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="84dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.3"
        android:text="DATE"
        android:textAlignment="textStart"
        android:textColor="@color/DarkViolet"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cate_heading" />

    <TextView
        android:id="@+id/description_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.3"
        android:text="CATEGORY"
        android:textAlignment="textStart"
        android:textColor="@color/DarkViolet"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cate_name" />


    <TextView
        android:id="@+id/icon_lbl"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.3"
        android:text="EXPENSE RECEIPT IMAGES"
        android:textAlignment="textStart"
        android:textColor="@color/DarkViolet"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cate_limit" />

    <Spinner
        android:id="@+id/category_spinner"
        android:layout_width="353dp"
        android:layout_height="43dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/purple_button_border"
        android:spinnerMode="dropdown"
        android:textColor="@color/DarkViolet"
        android:textColorHint="@color/DarkViolet"
        android:textSize="14sp"
        app:iconTint="@color/DarkViolet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description_lbl" />

    <TextView
        android:id="@+id/limit_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.3"
        android:text="DESCRIPTION"
        android:textAlignment="textStart"
        android:textColor="@color/DarkViolet"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category_spinner" />

    <TextView
        android:id="@+id/limit_lbl2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="19dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.3"
        android:text="TOTAL AMOUNT SPENT"
        android:textAlignment="textStart"
        android:textColor="@color/DarkViolet"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cate_limit2" />

    <Button
        android:id="@+id/cate_save_btn"
        android:layout_width="136dp"
        android:layout_height="44dp"
        android:layout_marginTop="228dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/filled_purple_btn"
        android:cursorVisible="true"
        android:fontFamily="monospace"
        android:text="SAVE"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/cate_cancel_btn"
        app:layout_constraintTop_toBottomOf="@+id/cate_limit" />

    <Button
        android:id="@+id/cate_cancel_btn"
        android:layout_width="136dp"
        android:layout_height="44dp"
        android:layout_marginEnd="80dp"
        android:background="@drawable/orange_button_border"
        android:fontFamily="monospace"
        android:text="CANCEL"
        android:textColor="@color/DarkViolet"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/cate_save_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cate_save_btn"
        app:layout_constraintVertical_bias="1.0" />

    <RadioButton
        android:id="@+id/Expense_btn"
        android:layout_width="116dp"
        android:layout_height="43dp"
        android:layout_marginStart="72dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="30dp"
        android:fontFamily="monospace"
        android:text="EXPENSES"
        android:textAlignment="textStart"
        android:textColor="@color/DarkOrange"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/category_lbl"
        app:layout_constraintEnd_toStartOf="@+id/Income_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cate_heading"
        app:layout_constraintVertical_bias="0.0" />

    <RadioButton
        android:id="@+id/Income_btn"
        android:layout_width="113dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="65dp"
        android:fontFamily="monospace"
        android:text="INCOME"
        android:textAlignment="textStart"
        android:textColor="@color/DarkOrange"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/cate_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/Expense_btn"
        app:layout_constraintTop_toBottomOf="@+id/cate_heading"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="121dp"
        android:layout_height="92dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="262dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_lbl"
        app:srcCompat="@android:drawable/ic_menu_report_image" />

</androidx.constraintlayout.widget.ConstraintLayout>

